# Copy to .env.production and replace all placeholders before deployment.
POSTGRES_DB=travelhub
POSTGRES_USER=travelhub
POSTGRES_PASSWORD=replace_with_url_safe_random_password
DATABASE_URL=postgresql+psycopg://travelhub:replace_with_url_safe_random_password@db:5432/travelhub

ENVIRONMENT=production
JWT_SECRET_KEY=replace_with_a_long_random_secret
CORS_ORIGINS=https://USER_DOMAIN,https://ADMIN_DOMAIN

USER_DOMAIN=USER_DOMAIN
ADMIN_DOMAIN=ADMIN_DOMAIN
API_DOMAIN=API_DOMAIN
VITE_API_BASE_URL=https://API_DOMAIN/api/v1
TLS_CERTS_DIR=./deploy/certs
