# Run with: docker compose -f docker-compose.yml -f docker-compose.pc-tunnel.yml up -d --build public-web cloudflared
# No public host ports for web or tunnel. Never deploy the Vite dev server directly.
services:
  backend:
    environment:
      ENVIRONMENT: production
    command: uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1

  public-web:
    build:
      context: .
      dockerfile: deploy/Dockerfile.pc-tunnel
    restart: unless-stopped
    init: true
    expose:
      - "8080"
    depends_on:
      backend:
        condition: service_healthy
    networks:
      - default
      - tunnel_edge
    read_only: true
    tmpfs:
      - /var/cache/nginx
      - /var/run
      - /tmp
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETUID
      - SETGID
    security_opt:
      - no-new-privileges:true

  admin-web:
    build:
      context: .
      dockerfile: deploy/Dockerfile.admin-tunnel
    restart: unless-stopped
    init: true
    expose:
      - "8081"
    depends_on:
      backend:
        condition: service_healthy
    networks:
      - default
      - tunnel_edge
    read_only: true
    tmpfs:
      - /var/cache/nginx
      - /var/run
      - /tmp
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETUID
      - SETGID
    security_opt:
      - no-new-privileges:true

  cloudflared:
    image: cloudflare/cloudflared:latest
    restart: unless-stopped
    init: true
    command: tunnel --no-autoupdate run
    env_file:
      - .env.tunnel
    depends_on:
      - public-web
    networks:
      - tunnel_edge
    read_only: true
    tmpfs:
      - /tmp
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true

networks:
  tunnel_edge:
    internal: false

