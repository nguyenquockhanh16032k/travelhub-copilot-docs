# Local development only. Copy to .env and replace values.
POSTGRES_DB=travelhub
POSTGRES_USER=travelhub
POSTGRES_PASSWORD=change_this_local_password
DATABASE_URL=postgresql+psycopg://travelhub:change_this_local_password@db:5432/travelhub

JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
BOOKING_PENDING_HOLD_MINUTES=30
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

VITE_API_BASE_URL=http://localhost:8000/api/v1

# Development seed only. Do not use these values in production.
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=change_this_local_seed_password
