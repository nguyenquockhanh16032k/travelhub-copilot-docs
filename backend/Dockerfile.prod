FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN groupadd --system travelhub \
    && useradd --system --gid travelhub --home-dir /app --no-create-home travelhub

COPY requirements-runtime.txt .
RUN pip install --no-cache-dir -r requirements-runtime.txt

COPY --chown=travelhub:travelhub app ./app
COPY --chown=travelhub:travelhub alembic ./alembic
COPY --chown=travelhub:travelhub alembic.ini .

USER travelhub

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
