# Build the admin SPA as static files; Vite development server is not exposed.
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend-admin/package*.json ./
RUN npm ci
COPY frontend-admin/ ./
ENV VITE_API_BASE_URL=/api/v1
RUN npm run build

FROM nginx:stable-alpine
COPY deploy/nginx/admin-tunnel.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/ /usr/share/nginx/html/
EXPOSE 8081
